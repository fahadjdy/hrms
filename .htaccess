# Used only when the domain's document root is this project folder rather than
# /public (common on shared hosting). Every request is handed to /public, so
# nothing outside it (.env, storage, vendor…) can be requested directly.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# If mod_rewrite is unavailable, refuse everything instead of exposing files.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
